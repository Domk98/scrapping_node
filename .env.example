# Copy to .env in the repository root. Never commit real values.
NODE_ENV=development
PORT=5001
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=scraping_demo
# Authorized API returning {"demo": ["example_profile"]}
SOURCE_API_URL=
# Authorized activity page URL template, containing {nickname}
SCRAPER_URL_TEMPLATE=
CONCURRENCY=5
# PHP endpoints require this value as Authorization: Bearer <value>
API_ACCESS_TOKEN=
# Optional suffix added to PHP cd query parameter (empty by default)
TENANT_SUFFIX=
